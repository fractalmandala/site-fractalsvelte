{
	"name": "fractalsvelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"check:classes": "node scripts/check-classes.ts",
		"docs:npm": "node scripts/sync-docs.ts",
		"docs:copy": "node scripts/copy-docs.ts",
		"docs:sync": "pnpm docs:copy && pnpm docs:npm",
		"check:seo": "node scripts/check-seo.ts",
		"fonts": ".venv/bin/python scripts/build-fonts.py",
		"lint:cui": "node ../../packages/ui-automation-playbook/affedo/scripts/cui-lint.mjs $(find src -name \"*.svelte\")"
	},
	"devDependencies": {
		"@ethercorps/sveltekit-og": "^4.4.0",
		"@fractaldesign/fractalstyler": "^1.2.0",
		"@fractaldesign/pop-mdsvex": "^0.1.1",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"mdsvex": "^0.12.8",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#og/*": "./og/*"
	},
	"dependencies": {
		"@fractaldesign/fractalsvelte-ui": "file:../../packages/fractalsvelte-ui",
		"@fractaldesign/machines-ui": "file:../../packages/machines-ui",
		"@fractaldesign/pop": "^0.1.0",
		"fractalicons": "^0.4.0"
	}
}
